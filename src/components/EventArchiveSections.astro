---
import EventGrid from './EventGrid.astro';
import type { EventSummary } from '@/content/types';
import { groupEventsByYear } from '@/utils/events';

interface Props {
  events: EventSummary[];
}

const groups = groupEventsByYear(Astro.props.events);
---

{groups.map(({ year, events }) => (
  <section class="event-archive__group" aria-labelledby={`eventi-${year}`}>
    <h2 id={`eventi-${year}`}>{year}</h2>
    <EventGrid events={events} />
  </section>
))}
