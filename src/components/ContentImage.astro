---
import { Image } from 'astro:assets';
import { getRemoteImageSize } from '@/utils/remoteImageSize';

type Variant = 'card' | 'hero' | 'poster' | 'portrait' | 'gallery' | 'logo';

interface Props {
  src: string;
  alt: string;
  variant: Variant;
  eager?: boolean;
}

const { src, alt, variant, eager = false } = Astro.props;

const dimensions: Record<Variant, { width: number; height: number; fit: 'cover' | 'contain' }> = {
  card: { width: 800, height: 560, fit: 'cover' },
  hero: { width: 1200, height: 760, fit: 'cover' },
  poster: { width: 900, height: 1200, fit: 'contain' },
  portrait: { width: 500, height: 600, fit: 'cover' },
  gallery: { width: 1200, height: 900, fit: 'contain' },
  logo: { width: 300, height: 160, fit: 'contain' },
};

const { width, height, fit } = dimensions[variant];
const originalSize = fit === 'contain' ? await getRemoteImageSize(src) : null;
const outputHeight = originalSize ? Math.max(1, Math.round(width * originalSize.height / originalSize.width)) : height;
---

{fit === 'cover' ? (
  <Image
    src={src}
    alt={alt}
    width={width}
    height={height}
    layout="constrained"
    fit="cover"
    quality="mid"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    class={`content-image content-image--${variant}`}
  />
) : (
  <Image
    src={src}
    alt={alt}
    width={width}
    height={outputHeight}
    layout="constrained"
    fit="contain"
    quality="mid"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    class={`content-image content-image--${variant}`}
  />
)}
