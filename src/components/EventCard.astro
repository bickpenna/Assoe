---
import ContentImage from './ContentImage.astro';
import { BRAND_WORDMARK } from '@/config/site';

interface Props {
  href: string;
  title: string;
  imageUrl?: string;
  meta?: string;
}

const { href, title, imageUrl, meta } = Astro.props;
---

<article class="content-card">
  <a class="content-card__link" href={href} aria-label={`Apri evento: ${title}`}>
    <div class="content-card__media">
      {
        imageUrl ? (
          <ContentImage src={imageUrl} alt="" variant="poster" />
        ) : (
          <span class="content-card__placeholder" aria-hidden="true">{BRAND_WORDMARK}</span>
        )
      }
    </div>
    <div class="content-card__body">
      <p class="eyebrow">Evento</p>
      <h3>{title}</h3>
      {meta && <p class="content-card__meta">{meta}</p>}
      <span class="text-link">Scopri di più <span aria-hidden="true">↗</span></span>
    </div>
  </a>
</article>
