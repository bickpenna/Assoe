---
import { BRAND_WORDMARK } from '@/config/site';
---

<p class="eyebrow brand-eyebrow">{BRAND_WORDMARK}</p>

<style>
  /* Keep .eyebrow for the surrounding layout's spacing rules. */
  .brand-eyebrow {
    white-space: nowrap;
    color: var(--red);
    text-transform: none;
    letter-spacing: .14em;
    font-size: .72rem;
    font-weight: 800;
    line-height: 1.4;
  }
</style>
