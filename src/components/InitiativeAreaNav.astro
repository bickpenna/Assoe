---
import type { InitiativeArea } from '@/content/types';
import { initiativeSections } from '@/utils/initiatives';
import { sitePath } from '@/utils/sitePath';

interface Props {
  current?: InitiativeArea;
}
const { current } = Astro.props;
---

<nav class="initiative-area-nav" aria-label="Ambiti delle iniziative">
  {initiativeSections.map(({ value, title, path }) => (
    <a href={sitePath(path)} aria-current={current === value ? 'page' : undefined}>{value === 'social' ? 'Sociali' : title}</a>
  ))}
</nav>
