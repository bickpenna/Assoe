---
interface Props {
  id: string;
  title: string;
  description: string;
}

const { id, title, description } = Astro.props;
---

<section class="section detail__related" aria-labelledby={id}>
  <h2 id={id}>{title}</h2>
  <p class="section__intro detail__related-intro">{description}</p>
  <slot />
</section>
