---
import ContentImage from './ContentImage.astro';
import type { ProjectSummary } from '@/content/types';

interface Props {
  projects: ProjectSummary[];
  headingLevel?: 2 | 3;
}

const { projects, headingLevel = 3 } = Astro.props;
const hasImages = projects.some(({ imageUrl }) => Boolean(imageUrl));
---

<ul class:list={['project-list', { 'project-list--with-images': hasImages, 'project-list--single': projects.length === 1, 'project-list--two': projects.length === 2 }]}>
  {projects.map((project) => (
    <li class="project-list__item">
      <a class:list={['project-list__link', { 'project-list__link--text-only': !project.imageUrl }]} href={`/progetti/${project.slug}/`}>
        <div class="project-list__content">
          <p class="eyebrow">Asso è…</p>
          {headingLevel === 2 ? <h2>{project.name}</h2> : <h3>{project.name}</h3>}
          <span class="project-list__bottom">
            <span class="project-list__more">Scopri il progetto</span>
            <span class="project-list__arrow" aria-hidden="true">↗</span>
          </span>
        </div>
        {project.imageUrl && (
          <span class="project-list__media"><ContentImage src={project.imageUrl} alt="" variant="card" /></span>
        )}
      </a>
    </li>
  ))}
</ul>
