---
import { sitePath } from '@/utils/sitePath';

interface Props {
  archive?: boolean;
}
const { archive = false } = Astro.props;
---

<nav class="event-archive__nav" aria-label="Sezioni degli eventi">
  <a href={sitePath('/eventi/')} aria-current={!archive ? 'page' : undefined}>In programma</a>
  <a href={sitePath('/eventi/archivio/')} aria-current={archive ? 'page' : undefined}>Archivio eventi</a>
</nav>
