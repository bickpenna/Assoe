---
import type { AssociationInfo } from '@/content/types';
import { sitePath } from '@/utils/sitePath';

interface Props {
  association: AssociationInfo | null;
  href: string;
}

const { association, href } = Astro.props;
const hasContactMethods = Boolean(association?.contacts.email || association?.contacts.phone || association?.socialLinks.length);
---

{hasContactMethods && (
  <section class="about-join section" aria-labelledby="unisciti-associazione">
    <div class="about-join__panel">
      <div>
        <h2 id="unisciti-associazione">Vuoi unirti a noi?</h2>
        <p>Ti piacerebbe dare una mano? Scrivici e raccontaci come vorresti partecipare.</p>
      </div>
      <a class="button" href={href.startsWith('/') ? sitePath(href) : href}>Contattaci</a>
    </div>
  </section>
)}

<style>
  .about-join__panel { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem 2rem; padding: clamp(1.5rem, 3vw, 2.5rem); border-radius: 1.5rem; background: var(--surface-muted); }
  .about-join h2 { margin: 0 0 .4rem; font-size: clamp(1.6rem, 2.5vw, 2.3rem); }
  .about-join p { max-width: 35rem; margin: 0; color: var(--muted); }
  .about-join .button { flex: 0 0 auto; }

  @media (max-width: 760px) {
    .about-join__panel { align-items: flex-start; flex-direction: column; }
  }
</style>
