---
import ContentImage from './ContentImage.astro';
import { BRAND_SUBTITLE, BRAND_WORDMARK, SITE_NAME } from '@/config/site';
import { sitePath } from '@/utils/sitePath';

interface Props {
  logoUrl?: string;
  name?: string;
}

const {
  logoUrl,
  name = SITE_NAME,
} = Astro.props;
---

<a class="brand brand--header" href={sitePath('/')} aria-label={`${name}, pagina iniziale`}>
  {logoUrl && <ContentImage src={logoUrl} alt="" variant="logo" eager />}
  <span class="brand__wordmark">
    <strong class="brand__main">{BRAND_WORDMARK}</strong>
    <span class="brand__sub">{BRAND_SUBTITLE}</span>
  </span>
</a>
