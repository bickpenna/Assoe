---
import { SITE_NAME } from '@/config/site';
import type { AssociationInfo } from '@/content/types';
import { sitePath } from '@/utils/sitePath';

interface Props {
  association: AssociationInfo | null;
}

const { association } = Astro.props;
const name = association?.name || SITE_NAME;
const contacts = association?.contacts;
const hasAddress = Boolean(contacts?.address || contacts?.postalCode || contacts?.city || contacts?.province);
const documents = association?.documents;
const hasDocuments = Boolean(documents?.statuteUrl || documents?.regulationUrl || documents?.privacyPolicyUrl || documents?.cookiePolicyUrl);
const copyright = association?.copyright?.trim();
const copyrightLabel = copyright
  ? copyright.startsWith('©') ? copyright : `© ${copyright}${/^\d{4}$/.test(copyright) ? ` ${name}` : ''}`
  : `© ${new Date().getFullYear()} ${name}`;
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__main">
      <div class="site-footer__identity">
        <strong>{name}</strong>
        <div class="site-footer__details">
          {hasAddress && (
            <address>
              {contacts?.address && <span>{contacts.address}</span>}
              {(contacts?.postalCode || contacts?.city || contacts?.province) && (
                <span>{[contacts?.postalCode, contacts?.city, contacts?.province].filter(Boolean).join(' ')}</span>
              )}
            </address>
          )}
          {association?.taxCode && <span>Codice fiscale {association.taxCode}</span>}
          {association?.registryInfo && <span>{association.registryInfo}</span>}
        </div>
      </div>

      <nav class="site-footer__links" aria-label="Collegamenti utili">
        <a href={sitePath('/sostienici/#cinque-per-mille')}>5×1000</a>
        <a href={sitePath('/sostienici/#donazione')}>Donazioni</a>
        <a href={sitePath('/chi-siamo/#contatti')}>Contattaci</a>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <span>{copyrightLabel}</span>
      <nav
        class:list={['site-footer__bottom-links', !hasDocuments && 'site-footer__bottom-links--contact-only']}
        aria-label="Contatti e documenti"
      >
        {documents?.privacyPolicyUrl && <a href={documents.privacyPolicyUrl}>Privacy</a>}
        <a class="site-footer__contact-mobile" href={sitePath('/chi-siamo/#contatti')}>Contattaci</a>
        {hasDocuments && <a href={sitePath('/chi-siamo/#documenti-associazione')}>Documenti</a>}
      </nav>
    </div>
  </div>
</footer>
