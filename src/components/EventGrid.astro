---
import EventCard from './EventCard.astro';
import type { EventSummary } from '@/content/types';
import { formatDateTime } from '@/utils/date';
import { eventStatusLabel } from '@/utils/labels';
import { eventDisplayStatus } from '@/utils/events';
import { sitePath } from '@/utils/sitePath';

interface Props {
  events: EventSummary[];
}

const { events } = Astro.props;
---

<div class="content-grid">
  {events.map((event) => (
    <EventCard href={sitePath(`/eventi/${event.slug}/`)} title={event.title} imageUrl={event.imageUrl} meta={`${formatDateTime(event.date)} · ${eventStatusLabel(eventDisplayStatus(event))}${event.place ? ` · ${event.place}` : ''}`} />
  ))}
</div>
