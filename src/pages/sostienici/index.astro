---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { contentRepository } from '@/content';
import { SITE_NAME } from '@/config/site';

const association = await contentRepository.getAssociationInfo();
const taxCode = association?.taxCode?.trim();
const bankDetails = association?.bankDetails;
---

<BaseLayout
  title={`Sostienici | ${SITE_NAME}`}
  description="Scopri come sostenere Asso è… con il 5×1000 o una donazione tramite bonifico."
  association={association}
>
  <main id="contenuto" class="container support-page">
    <div class="page-intro support-page__intro">
      <p class="eyebrow">Facciamo strada insieme</p>
      <h1>Sostienici</h1>
      <p>Puoi destinare il tuo 5×1000 all’associazione oppure fare una donazione con bonifico. Qui trovi i dati per scegliere come sostenerci.</p>
    </div>

    <section class="support-method support-method--tax" id="cinque-per-mille" aria-labelledby="cinque-per-mille-title">
      <div class="support-method__intro">
        <p class="eyebrow">5×1000</p>
        <h2 id="cinque-per-mille-title">Una scelta nella dichiarazione dei redditi</h2>
        <p>Nella scheda per l’8, il 5 e il 2 per mille, firma nel riquadro pertinente e indica il codice fiscale dell’associazione.</p>
        <p>Modelli e scadenze possono cambiare: consulta le <a href="https://infoprecompilata.agenziaentrate.gov.it/portale/scelte-8-5-e-2-per-mille3">istruzioni aggiornate dell’Agenzia delle Entrate</a> per l’anno della tua dichiarazione.</p>
      </div>
      <div class="support-method__panel">
        <p class="eyebrow">Il codice da indicare</p>
        {taxCode ? (
          <>
            <p class="support-method__name">{association?.name}</p>
            <p class="support-method__code" aria-label={`Codice fiscale ${taxCode}`}>{taxCode}</p>
          </>
        ) : (
          <p>Il codice fiscale non è ancora disponibile su questa pagina. <a href="/chi-siamo/#contatti">Contattaci</a> prima di compilare la scelta.</p>
        )}
      </div>
    </section>

    <section class="support-method support-method--donation" id="donazione" aria-labelledby="donazione-title">
      <div class="support-method__intro">
        <p class="eyebrow">Donazione</p>
        <h2 id="donazione-title">Una donazione con bonifico</h2>
        <p>Se preferisci sostenerci direttamente, puoi fare un bonifico sul conto dell’associazione. Trovi qui le coordinate da usare.</p>
        <p>Hai una domanda prima di donare? <a href="/chi-siamo/#contatti">Scrivici</a>.</p>
      </div>
      <div class="support-method__panel support-method__panel--bank">
        {bankDetails ? (
          <dl class="support-method__bank-details">
            <div>
              <dt>IBAN</dt>
              <dd class="support-method__iban">{bankDetails.iban}</dd>
            </div>
            <div>
              <dt>Intestatario</dt>
              <dd>{bankDetails.accountHolder}</dd>
            </div>
            {bankDetails.bankName && (
              <div>
                <dt>Banca</dt>
                <dd>{bankDetails.bankName}</dd>
              </div>
            )}
          </dl>
        ) : (
          <>
            <p class="eyebrow">Coordinate bancarie</p>
            <p>Le coordinate per il bonifico non sono ancora disponibili sul sito. <a href="/chi-siamo/#contatti">Contattaci</a> per sapere come donare.</p>
          </>
        )}
      </div>
    </section>
  </main>
</BaseLayout>
