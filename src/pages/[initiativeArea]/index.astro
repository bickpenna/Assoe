---
import type { GetStaticPaths } from 'astro';
import ArchiveLayout from '@/layouts/ArchiveLayout.astro';
import InitiativeAreaNav from '@/components/InitiativeAreaNav.astro';
import InitiativeList from '@/components/InitiativeList.astro';
import { contentRepository } from '@/content';
import { groupInitiatives } from '@/utils/initiatives';
import { ARCHIVE_PAGE_SIZE } from '@/config/pagination';

export const getStaticPaths = (async () => {
  const groups = groupInitiatives(await contentRepository.listInitiatives());
  return groups.map((group) => ({ params: { initiativeArea: group.slug }, props: { group } }));
}) satisfies GetStaticPaths;

interface Props {
  group: ReturnType<typeof groupInitiatives>[number];
}
const { group } = Astro.props;
---

<ArchiveLayout title={group.title} description={group.description} emptyMessage={group.emptyMessage} basePath={group.path} currentPage={1} totalItems={group.initiatives.length}>
  <InitiativeAreaNav slot="navigation" current={group.value} />
  <InitiativeList initiatives={group.initiatives.slice(0, ARCHIVE_PAGE_SIZE)} headingLevel={2} showArea={false} />
</ArchiveLayout>
