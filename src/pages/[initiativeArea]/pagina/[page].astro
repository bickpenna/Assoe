---
import type { GetStaticPaths, Page } from 'astro';
import ArchiveLayout from '@/layouts/ArchiveLayout.astro';
import InitiativeAreaNav from '@/components/InitiativeAreaNav.astro';
import InitiativeList from '@/components/InitiativeList.astro';
import { contentRepository } from '@/content';
import type { InitiativeSummary } from '@/content/types';
import { groupInitiatives, initiativeSections } from '@/utils/initiatives';
import { ARCHIVE_PAGE_SIZE } from '@/config/pagination';

export const getStaticPaths = (async ({ paginate }) => {
  const groups = groupInitiatives(await contentRepository.listInitiatives());
  return groups.flatMap((group) => paginate(group.initiatives, {
    pageSize: ARCHIVE_PAGE_SIZE,
    params: { initiativeArea: group.slug },
    props: { group },
  }).slice(1));
}) satisfies GetStaticPaths;

interface Props {
  page: Page<InitiativeSummary>;
  group: (typeof initiativeSections)[number];
}
const { group, page } = Astro.props;
---

<ArchiveLayout title={group.title} description={group.description} emptyMessage={group.emptyMessage} basePath={group.path} currentPage={page.currentPage} totalItems={page.total}>
  <InitiativeAreaNav slot="navigation" current={group.value} />
  <InitiativeList initiatives={page.data} headingLevel={2} showArea={false} />
</ArchiveLayout>
