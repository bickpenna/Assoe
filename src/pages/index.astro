---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleList from '@/components/ArticleList.astro';
import ContentImage from '@/components/ContentImage.astro';
import InitiativeList from '@/components/InitiativeList.astro';
import { contentRepository } from '@/content';
import { formatDateTime } from '@/utils/date';
import { getNextEvent } from '@/utils/events';
import { ARTICLES_TITLE, BRAND_WORDMARK, SITE_NAME } from '@/config/site';
import { sitePath } from '@/utils/sitePath';

const [initiatives, articles, events, association] = await Promise.all([
  contentRepository.listInitiatives(),
  contentRepository.listArticles(),
  contentRepository.listEvents(),
  contentRepository.getAssociationInfo(),
]);

const featuredEvent = getNextEvent(events);
---

<BaseLayout title={SITE_NAME} association={association}>
  <main id="contenuto">
    <section class="hero">
      <div class="container hero__panel">
        <div class="hero__text">
          <p class="eyebrow">La Strada ci Insegna · ODV</p>
          <h1>{BRAND_WORDMARK}<br />La Strada ci Insegna.</h1>
          <div class="hero__actions">
            <a class="button" href={sitePath('/iniziative/')}>Scopri le iniziative <span aria-hidden="true">&nbsp;↗</span></a>
            <a class="button button--light" href={sitePath('/chi-siamo/')}>Chi siamo</a>
          </div>
        </div>
        {association?.logoUrl ? (
          <div class="hero__logo"><ContentImage src={association.logoUrl} alt={`Logo di ${association.name}`} variant="logoLarge" eager /></div>
        ) : (
          <div class="hero__art" aria-hidden="true"><span>è</span></div>
        )}
      </div>
    </section>

    {featuredEvent && (
      <section class="section container" aria-labelledby="eventi-home">
        <div class="section__header">
          <div>
            <p class="eyebrow">{BRAND_WORDMARK}</p>
            <h2 id="eventi-home">Il prossimo appuntamento</h2>
            <p class="section__intro">Incontri, attività e momenti da condividere.</p>
          </div>
          <a class="text-link" href={sitePath('/eventi/')}>Vedi tutti gli eventi <span aria-hidden="true">↗</span></a>
        </div>
        <article class="event-feature">
          <div class="event-feature__media">
            {featuredEvent.imageUrl ? (
              <ContentImage src={featuredEvent.imageUrl} alt={`Locandina di ${featuredEvent.title}`} variant="poster" />
            ) : (
              <div class="event-feature__placeholder" aria-hidden="true">{BRAND_WORDMARK}</div>
            )}
          </div>
          <div class="event-feature__body">
            <p class="eyebrow">Ci vediamo presto</p>
            <h3>{featuredEvent.title}</h3>
            <p><time datetime={featuredEvent.date}>{formatDateTime(featuredEvent.date)}</time></p>
            {featuredEvent.place && <p>{featuredEvent.place}</p>}
            <a class="button" href={sitePath(`/eventi/${featuredEvent.slug}/`)}>Scopri l’evento</a>
          </div>
        </article>
      </section>
    )}

    <section class="section container home-initiatives" aria-labelledby="iniziative-home">
      <div class="section__header">
        <div>
          <p class="eyebrow">{BRAND_WORDMARK}</p>
          <h2 id="iniziative-home">Le nostre iniziative</h2>
          <p class="section__intro">Le idee a cui stiamo dando forma, una alla volta.</p>
        </div>
        <a class="text-link" href={sitePath('/iniziative/')}>Esplora le iniziative <span aria-hidden="true">↗</span></a>
      </div>
      {
        initiatives.length > 0 ? (
          <InitiativeList initiatives={initiatives.slice(0, 4)} columns={2} />
        ) : (
          <p class="notice">Per ora non ci sono iniziative da mostrarti.</p>
        )
      }
    </section>

    <section class="section container" aria-labelledby="articoli-home">
      <div class="section__header">
        <div>
          <p class="eyebrow">Dal territorio</p>
          <h2 id="articoli-home">{ARTICLES_TITLE}</h2>
          <p class="section__intro">Racconti e aggiornamenti da leggere con calma.</p>
        </div>
        <a class="text-link" href={sitePath('/articoli/')}>Sfoglia gli articoli <span aria-hidden="true">↗</span></a>
      </div>
      {
        articles.length > 0 ? (
          <ArticleList articles={articles.slice(0, 3)} />
        ) : (
          <p class="notice">Per ora non ci sono articoli da leggere.</p>
        )
      }
    </section>

    <section class="container five-per-mille" aria-labelledby="cinque-per-mille-home">
      <div>
        <p class="eyebrow">5×1000</p>
        <h2 id="cinque-per-mille-home">Il tuo 5×1000 può fare strada.</h2>
        <p>Scopri come scegliere Asso è… e dove trovare il nostro codice fiscale.</p>
      </div>
      <a class="button" href={sitePath('/sostienici/#cinque-per-mille')}>Come fare <span aria-hidden="true">&nbsp;↗</span></a>
    </section>
  </main>
</BaseLayout>
