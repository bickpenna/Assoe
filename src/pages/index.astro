---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleList from '@/components/ArticleList.astro';
import ContentImage from '@/components/ContentImage.astro';
import ProjectList from '@/components/ProjectList.astro';
import { contentRepository } from '@/content';
import { formatDateTime } from '@/utils/date';
import { BRAND_WORDMARK, SITE_NAME } from '@/config/site';

const [projects, articles, events, association] = await Promise.all([
  contentRepository.listProjects(),
  contentRepository.listArticles(),
  contentRepository.listEvents(),
  contentRepository.getAssociationInfo(),
]);

const upcomingEvents = events
  .filter((event) => event.status === 'ongoing' || (event.status === 'scheduled' && new Date(event.date).getTime() >= Date.now()))
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());
const featuredEvent = upcomingEvents[0] ?? events[0];
const eventHeading = upcomingEvents.length > 0 ? 'Prossimo evento' : 'Eventi e iniziative';
---

<BaseLayout title={SITE_NAME} association={association}>
  <main id="contenuto">
    <section class="hero">
      <div class="container hero__panel">
        <div class="hero__text">
          <p class="eyebrow">La Strada ci Insegna · ODV</p>
          <h1>{BRAND_WORDMARK}<br />La Strada ci Insegna.</h1>
          <div class="hero__actions">
            <a class="button" href="/progetti/">Scopri i progetti <span aria-hidden="true">&nbsp;↗</span></a>
            <a class="button button--light" href="/chi-siamo/">Chi siamo</a>
          </div>
        </div>
        {association?.logoUrl ? (
          <div class="hero__logo"><ContentImage src={association.logoUrl} alt={`Logo di ${association.name}`} variant="logoLarge" eager /></div>
        ) : (
          <div class="hero__art" aria-hidden="true"><span>è</span></div>
        )}
      </div>
    </section>

    <section class="section container" aria-labelledby="eventi-home">
      <div class="section__header">
        <div>
          <p class="eyebrow">{BRAND_WORDMARK}</p>
          <h2 id="eventi-home">{eventHeading}</h2>
        </div>
        <a class="text-link" href="/eventi/">Tutti gli eventi <span aria-hidden="true">↗</span></a>
      </div>
      {
        featuredEvent ? (
          <article class="event-feature">
            <div class="event-feature__media">
              {featuredEvent.imageUrl ? (
                <ContentImage src={featuredEvent.imageUrl} alt={`Locandina di ${featuredEvent.title}`} variant="poster" />
              ) : (
                <div class="event-feature__placeholder" aria-hidden="true">{BRAND_WORDMARK}</div>
              )}
            </div>
            <div class="event-feature__body">
              <p class="eyebrow">{upcomingEvents.length > 0 ? 'In programma' : 'Dal nostro archivio'}</p>
              <h3>{featuredEvent.title}</h3>
              <p><time datetime={featuredEvent.date}>{formatDateTime(featuredEvent.date)}</time></p>
              {featuredEvent.place && <p>{featuredEvent.place}</p>}
              <a class="button" href={`/eventi/${featuredEvent.slug}/`}>Dettagli dell’evento</a>
            </div>
          </article>
        ) : (
          <p class="notice">I prossimi eventi saranno pubblicati qui.</p>
        )
      }
    </section>

    <section class="section container" aria-labelledby="progetti-home">
      <div class="section__header">
        <div>
          <p class="eyebrow">{BRAND_WORDMARK}</p>
          <h2 id="progetti-home">I nostri progetti</h2>
        </div>
        <a class="text-link" href="/progetti/">Tutti i progetti <span aria-hidden="true">↗</span></a>
      </div>
      {
        projects.length > 0 ? (
          <ProjectList projects={projects.slice(0, 3)} />
        ) : (
          <p class="notice">I progetti saranno pubblicati presto.</p>
        )
      }
    </section>

    <section class="section container" aria-labelledby="articoli-home">
      <div class="section__header">
        <div>
          <p class="eyebrow">Dal territorio</p>
          <h2 id="articoli-home">Articoli e storie</h2>
        </div>
        <a class="text-link" href="/articoli/">Tutti gli articoli <span aria-hidden="true">↗</span></a>
      </div>
      {
        articles.length > 0 ? (
          <ArticleList articles={articles.slice(0, 3)} />
        ) : (
          <p class="notice">Gli articoli saranno pubblicati presto.</p>
        )
      }
    </section>

    <section class="container five-per-mille" aria-labelledby="cinque-per-mille-home">
      <div>
        <p class="eyebrow">5×1000</p>
        <h2 id="cinque-per-mille-home">Una scelta che può fare strada.</h2>
        <p>Scopri come funziona il 5×1000 e dove trovare le indicazioni ufficiali.</p>
      </div>
      <a class="button button--light" href="/5x1000/">Come funziona <span aria-hidden="true">&nbsp;↗</span></a>
    </section>
  </main>
</BaseLayout>
