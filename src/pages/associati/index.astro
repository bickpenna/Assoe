---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JoinUsCta from '@/components/JoinUsCta.astro';
import PersonCard from '@/components/PersonCard.astro';
import { contentRepository } from '@/content';
import { groupPeopleByRole } from '@/utils/people';
import { SITE_NAME } from '@/config/site';

const [association, people] = await Promise.all([
  contentRepository.getAssociationInfo(),
  contentRepository.listPeople(),
]);

const groups = groupPeopleByRole(people);
---

<BaseLayout title={`Associati | ${SITE_NAME}`} association={association}>
  <main id="contenuto" class="container people-page">
    <div class="page-intro">
      <p class="eyebrow">Associazione di volontariato</p>
      <h1>Le persone di Asso è…</h1>
      <p>Qui puoi conoscere le persone che fanno parte della nostra associazione.</p>
    </div>

    {groups.length === 0 ? (
      <p class="notice">Le persone dell’associazione saranno pubblicate presto.</p>
    ) : (
      groups.map((group) => (
        <section class="people-role" aria-labelledby={`ruolo-${group.role}`}>
          <h2 id={`ruolo-${group.role}`}>{group.title}</h2>
          <ul class="people-grid">
            {group.people.map((person) => <PersonCard person={person} />)}
          </ul>
        </section>
      ))
    )}

    <JoinUsCta association={association} href="/chi-siamo/#contatti" />
  </main>
</BaseLayout>
