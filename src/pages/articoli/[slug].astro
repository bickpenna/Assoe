---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import EventCard from '@/components/EventCard.astro';
import ContentImage from '@/components/ContentImage.astro';
import DetailGallery from '@/components/DetailGallery.astro';
import RichTextContent from '@/components/RichTextContent.astro';
import ProjectList from '@/components/ProjectList.astro';
import RelatedContentSection from '@/components/RelatedContentSection.astro';
import FacebookDiscussion from '@/components/FacebookDiscussion.astro';
import { contentRepository } from '@/content';
import { formatDate } from '@/utils/date';
import { requireBySlug, staticPathsFromSlugs } from '@/utils/content';
import { SITE_NAME } from '@/config/site';

export const getStaticPaths = (async () => {
  const articles = await contentRepository.listArticles();

  return staticPathsFromSlugs(articles);
}) satisfies GetStaticPaths;

const slug = Astro.params.slug;
const article = await requireBySlug(slug, contentRepository.getArticleBySlug, 'Articolo');
---

<BaseLayout title={`${article.title} | ${SITE_NAME}`}>
  <main id="contenuto" class="container detail">
    <a class="text-link" href="/articoli/">← Tutti gli articoli</a>
    <article>
      <header class="detail__header">
        <p class="eyebrow">Articolo</p>
        <h1>{article.title}</h1>
        <p class="detail__meta"><time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time></p>
        {article.summary && <p>{article.summary}</p>}
      </header>

      {article.imageUrl && <div class="detail__image"><ContentImage src={article.imageUrl} alt={`Immagine dell’articolo ${article.title}`} variant="hero" eager /></div>}
      <RichTextContent html={article.bodyHtml} />
      <DetailGallery id="galleria" title="Galleria" imageAlt={article.title} imageUrls={article.galleryImageUrls} />

      {article.discussionUrl && <FacebookDiscussion url={article.discussionUrl} />}

      {
        article.relatedEvent && (
          <RelatedContentSection id="evento-articolo" title="C’è anche un evento" description="Un appuntamento legato a questa storia, da scoprire più da vicino.">
            <div class="content-grid"><EventCard href={`/eventi/${article.relatedEvent.slug}/`} title={article.relatedEvent.title} imageUrl={article.relatedEvent.imageUrl} /></div>
          </RelatedContentSection>
        )
      }

      {
        article.relatedProjects.length > 0 && (
          <RelatedContentSection id="progetti-articolo" title="Dietro questa storia" description="Scopri i progetti che si intrecciano con questo racconto.">
            <ProjectList projects={article.relatedProjects} />
          </RelatedContentSection>
        )
      }
    </article>
  </main>
</BaseLayout>
