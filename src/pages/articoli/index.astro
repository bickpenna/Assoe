---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleList from '@/components/ArticleList.astro';
import { contentRepository } from '@/content';
import { SITE_NAME } from '@/config/site';

const articles = await contentRepository.listArticles();
---

<BaseLayout title={`Articoli | ${SITE_NAME}`}>
  <main id="contenuto" class="container">
    <div class="page-intro">
      <p class="eyebrow">Dal territorio</p>
      <h1>Articoli e storie</h1>
    </div>
    {articles.length === 0 ? (
      <p class="notice">Non ci sono ancora articoli pubblicati.</p>
    ) : (
      <ArticleList articles={articles} headingLevel={2} />
    )}
  </main>
</BaseLayout>
