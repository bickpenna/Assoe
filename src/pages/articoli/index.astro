---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContentCard from '@/components/ContentCard.astro';
import { contentRepository } from '@/content';
import { formatDate } from '@/utils/date';

const articles = await contentRepository.listArticles();
---

<BaseLayout title="Articoli | Asso è… La Strada ci Insegna ODV">
  <main id="contenuto" class="container">
    <div class="page-intro">
      <p class="eyebrow">Dal territorio</p>
      <h1>Articoli e storie</h1>
    </div>
    {articles.length === 0 ? (
      <p class="notice">Non ci sono ancora articoli pubblicati.</p>
    ) : (
      <div class="content-grid">
        {articles.map((article) => (
          <ContentCard kind="article" headingLevel={2} href={`/articoli/${article.slug}/`} title={article.title} imageUrl={article.imageUrl} meta={formatDate(article.publishedAt)} summary={article.summary} />
        ))}
      </div>
    )}
  </main>
</BaseLayout>
