---
import type { GetStaticPaths, Page } from 'astro';
import ArchiveLayout from '@/layouts/ArchiveLayout.astro';
import InitiativeList from '@/components/InitiativeList.astro';
import { contentRepository } from '@/content';
import type { InitiativeSummary } from '@/content/types';
import { ARCHIVE_PAGE_SIZE } from '@/config/pagination';

export const getStaticPaths = (async ({ paginate }) => {
  const initiatives = await contentRepository.listInitiatives();
  return paginate(initiatives, { pageSize: ARCHIVE_PAGE_SIZE }).slice(1);
}) satisfies GetStaticPaths;

interface Props {
  page: Page<InitiativeSummary>;
}

const { page } = Astro.props;
---

<ArchiveLayout title="Le nostre iniziative" emptyMessage="Non ci sono ancora iniziative pubblicate." basePath="/iniziative/" currentPage={page.currentPage} totalItems={page.total}>
  <InitiativeList initiatives={page.data} headingLevel={2} />
</ArchiveLayout>
