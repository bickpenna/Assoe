---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { contentRepository } from '@/content';

const association = await contentRepository.getAssociationInfo();
const contacts = association?.contacts;
const hasAddress = Boolean(contacts?.address || contacts?.postalCode || contacts?.city || contacts?.province);
---

<BaseLayout title="Contatti | Asso è… La Strada ci Insegna ODV" association={association}>
  <main id="contenuto" class="container">
    <div class="page-intro">
      <p class="eyebrow">Restiamo in contatto</p>
      <h1>Contatti</h1>
      {association && <p>{association.name}</p>}
    </div>

    {
      !association ? (
        <p class="notice">I contatti dell’associazione non sono ancora disponibili.</p>
      ) : (
        <div class="info-grid">
          {contacts?.email && <section class="info-card"><h2>Email</h2><p><a href={`mailto:${contacts.email}`}>{contacts.email}</a></p></section>}
          {contacts?.phone && <section class="info-card"><h2>Telefono</h2><p><a href={`tel:${contacts.phone.replace(/[^+\d]/g, '')}`}>{contacts.phone}</a></p></section>}
          {hasAddress && (
            <section class="info-card">
              <h2>La sede</h2>
              <address>
                {contacts?.address && <div>{contacts.address}</div>}
                <div>{[contacts?.postalCode, contacts?.city, contacts?.province].filter(Boolean).join(' ')}</div>
              </address>
            </section>
          )}
          {association.socialLinks.length > 0 && (
            <section class="info-card" aria-labelledby="social-associazione">
              <h2 id="social-associazione">Social</h2>
              <ul class="link-list">
                {association.socialLinks.map((social) => (
                  <li><a href={social.url}>{social.name}</a></li>
                ))}
              </ul>
            </section>
          )}
        </div>
      )
    }
  </main>
</BaseLayout>
