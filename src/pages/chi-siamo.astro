---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContentImage from '@/components/ContentImage.astro';
import JoinUsCta from '@/components/JoinUsCta.astro';
import PersonCard from '@/components/PersonCard.astro';
import { contentRepository } from '@/content';
import { BRAND_WORDMARK, SITE_NAME } from '@/config/site';
import { getBoardMembers } from '@/utils/people';
import { toParagraphs } from '@/utils/paragraphs';
import { sitePath } from '@/utils/sitePath';

const [association, people] = await Promise.all([
  contentRepository.getAssociationInfo(),
  contentRepository.listPeople(),
]);
const boardMembers = getBoardMembers(people);
const aboutParagraphs = toParagraphs(association?.aboutText);

const documents = association ? [
  { label: 'Statuto', url: association.documents.statuteUrl },
  { label: 'Regolamento', url: association.documents.regulationUrl },
  { label: 'Informativa sulla privacy', url: association.documents.privacyPolicyUrl },
  { label: 'Informativa sui cookie', url: association.documents.cookiePolicyUrl },
].filter((document): document is { label: string; url: string } => Boolean(document.url)) : [];
const contacts = association?.contacts;
const hasAddress = Boolean(contacts?.address || contacts?.postalCode || contacts?.city || contacts?.province);
const hasContactMethods = Boolean(contacts?.email || contacts?.phone || association?.socialLinks.length);
---

<BaseLayout title={`Chi siamo | ${SITE_NAME}`} association={association}>
  <main id="contenuto" class="container">
    <div class="page-intro">
      <p class="eyebrow">{BRAND_WORDMARK}</p>
      <h1>Chi siamo</h1>
    </div>

    {aboutParagraphs.length > 0 && (
      <section class={association?.aboutImageUrl ? 'about-story about-story--with-image' : 'about-story'} aria-labelledby="storia-associazione">
        <div class="about-story__content">
          <p class="eyebrow">L’associazione</p>
          <h2 id="storia-associazione">Il nostro impegno</h2>
          {aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          <a class="text-link" href={sitePath('/iniziative/')}>Scopri le nostre iniziative ↗</a>
        </div>
        {association?.aboutImageUrl && (
          <div class="about-story__media"><ContentImage src={association.aboutImageUrl} alt="" variant="gallery" /></div>
        )}
      </section>
    )}

    <section class="about-contact section" id="contatti" aria-labelledby="sede-associazione">
      <div class:list={['about-contact__panel', { 'about-contact__panel--split': hasContactMethods }]}>
        <div class="about-contact__place" id="sede">
          <p class="eyebrow">Dove siamo</p>
          <h2 id="sede-associazione">La nostra sede</h2>
          {hasAddress ? (
            <address>
              {contacts?.address && <span>{contacts.address}</span>}
              {[contacts?.postalCode, contacts?.city, contacts?.province].some(Boolean) && (
                <span>{[contacts?.postalCode, contacts?.city, contacts?.province].filter(Boolean).join(' ')}</span>
              )}
            </address>
          ) : (
            <p>Per conoscere la nostra sede, scrivici.</p>
          )}
          {association?.registryInfo && <p class="about-contact__registry">{association.registryInfo}</p>}
        </div>
        {hasContactMethods && (
          <div class="about-contact__channels">
            <h3>Restiamo in contatto</h3>
            <dl>
              {contacts?.email && <div><dt>Email</dt><dd><a href={`mailto:${contacts.email}`}>{contacts.email}</a></dd></div>}
              {contacts?.phone && <div><dt>Telefono</dt><dd><a href={`tel:${contacts.phone.replace(/[^+\d]/g, '')}`}>{contacts.phone}</a></dd></div>}
              {association && association.socialLinks.length > 0 && (
                <div>
                  <dt>Seguici</dt>
                  <dd><ul>{association.socialLinks.map((social) => <li><a href={social.url}>{social.name}</a></li>)}</ul></dd>
                </div>
              )}
            </dl>
          </div>
        )}
      </div>
    </section>

    <section class="about-team section" aria-labelledby="direttivo-associazione">
      <div class:list={['about-team__panel', { 'about-team__panel--single': boardMembers.length === 1 }]}>
        <div class="about-team__intro">
          <p class="eyebrow">Le persone</p>
          <h2 id="direttivo-associazione">Il direttivo</h2>
          <p>Le persone che guidano l’associazione e ne seguono le attività.</p>
          <a class="text-link" href={sitePath('/associati/')}>Conosci tutti gli associati ↗</a>
        </div>
        {boardMembers.length > 0 ? (
          <ul class="people-grid about-board">
            {boardMembers.map((person) => <PersonCard person={person} />)}
          </ul>
        ) : (
          <p class="notice">Le persone del direttivo saranno pubblicate presto.</p>
        )}
      </div>
    </section>

    <JoinUsCta association={association} href="#contatti" />

    {
      documents.length > 0 && (
        <section class="section" aria-labelledby="documenti-associazione">
          <p class="eyebrow">Trasparenza</p>
          <h2 id="documenti-associazione">Documenti</h2>
          <ul class="link-list">
            {documents.map((document) => (
              <li><a href={document.url}>{document.label} (PDF)</a></li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</BaseLayout>
