---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContentImage from '@/components/ContentImage.astro';
import PersonCard from '@/components/PersonCard.astro';
import { contentRepository } from '@/content';
import { SITE_NAME } from '@/config/site';
import { getBoardMembers } from '@/utils/people';

const [association, people] = await Promise.all([
  contentRepository.getAssociationInfo(),
  contentRepository.listPeople(),
]);
const boardMembers = getBoardMembers(people);

const documents = association ? [
  { label: 'Statuto', url: association.documents.statuteUrl },
  { label: 'Regolamento', url: association.documents.regulationUrl },
  { label: 'Informativa sulla privacy', url: association.documents.privacyPolicyUrl },
  { label: 'Informativa sui cookie', url: association.documents.cookiePolicyUrl },
].filter((document): document is { label: string; url: string } => Boolean(document.url)) : [];
const contacts = association?.contacts;
const hasAddress = Boolean(contacts?.address || contacts?.postalCode || contacts?.city || contacts?.province);
const hasContactMethods = Boolean(contacts?.email || contacts?.phone || association?.socialLinks.length);
---

<BaseLayout title={`Chi siamo | ${SITE_NAME}`} association={association}>
  <main id="contenuto" class="container">
    <div class="page-intro">
      <p class="eyebrow">La nostra associazione</p>
      <h1>Chi siamo</h1>
      <p>{association?.name ?? SITE_NAME}</p>
    </div>

    <div class="info-grid">
      <section class="info-card">
        {association?.logoUrl && <ContentImage src={association.logoUrl} alt={`Logo di ${association.name}`} variant="logo" />}
        <h2>L’associazione</h2>
        <p>Conosci le nostre attività attraverso i <a href="/progetti/">progetti</a>, gli <a href="/eventi/">eventi</a> e gli <a href="/articoli/">articoli</a> pubblicati sul sito.</p>
        {association?.registryInfo && <p>{association.registryInfo}</p>}
      </section>
      <section class="info-card" id="sede">
        <h2>La sede</h2>
        {hasAddress ? (
          <address>
            {contacts?.address && <div>{contacts.address}</div>}
            <div>{[contacts?.postalCode, contacts?.city, contacts?.province].filter(Boolean).join(' ')}</div>
          </address>
        ) : (
          <p>Per conoscere la nostra sede, <a href="#contatti">contattaci</a>.</p>
        )}
        <p><a href="#contatti">Come contattarci</a></p>
      </section>
    </div>

    <section class="section" aria-labelledby="direttivo-associazione">
      <div class="section__header"><div><p class="eyebrow">Le persone</p><h2 id="direttivo-associazione">Il direttivo</h2></div></div>
      <p class="section__intro">Le persone che guidano l’associazione e ne seguono le attività.</p>
      {boardMembers.length > 0 ? (
        <ul class="people-grid about-board">
          {boardMembers.map((person) => <PersonCard person={person} />)}
        </ul>
      ) : (
        <p class="notice">Le persone del direttivo saranno pubblicate presto.</p>
      )}
      <p><a class="text-link" href="/associati/">Conosci tutti gli associati ↗</a></p>
    </section>

    <section class="section" id="contatti" aria-labelledby="contatti-associazione">
      <p class="eyebrow">Restiamo in contatto</p>
      <h2 id="contatti-associazione">Come contattarci</h2>
      {hasContactMethods ? (
        <div class="info-grid">
          {contacts?.email && <section class="info-card"><h3>Email</h3><p><a href={`mailto:${contacts.email}`}>{contacts.email}</a></p></section>}
          {contacts?.phone && <section class="info-card"><h3>Telefono</h3><p><a href={`tel:${contacts.phone.replace(/[^+\d]/g, '')}`}>{contacts.phone}</a></p></section>}
          {association && association.socialLinks.length > 0 && (
            <section class="info-card">
              <h3>Social</h3>
              <ul class="link-list">
                {association.socialLinks.map((social) => <li><a href={social.url}>{social.name}</a></li>)}
              </ul>
            </section>
          )}
        </div>
      ) : (
        <p class="notice">I contatti dell’associazione non sono ancora disponibili.</p>
      )}
    </section>

    {
      documents.length > 0 && (
        <section class="section" aria-labelledby="documenti-associazione">
          <p class="eyebrow">Trasparenza</p>
          <h2 id="documenti-associazione">Documenti</h2>
          <ul class="link-list">
            {documents.map((document) => (
              <li><a href={document.url}>{document.label} (PDF)</a></li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</BaseLayout>
