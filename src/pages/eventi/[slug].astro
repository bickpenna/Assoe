---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContentCard from '@/components/ContentCard.astro';
import ContentImage from '@/components/ContentImage.astro';
import { contentRepository } from '@/content';
import { formatDateTime } from '@/utils/date';
import { eventStatusLabel } from '@/utils/labels';
import { SITE_NAME } from '@/config/site';

export const getStaticPaths = (async () => {
  const events = await contentRepository.listEvents();

  return events.map(({ slug }) => ({ params: { slug } }));
}) satisfies GetStaticPaths;

const slug = Astro.params.slug;
const event = slug ? await contentRepository.getEventBySlug(slug) : null;

if (!event) {
  throw new Error(`Evento non trovato durante la build: ${slug ?? '(slug mancante)'}`);
}
---

<BaseLayout title={`${event.title} | ${SITE_NAME}`}>
  <main id="contenuto" class="container detail">
    <a class="text-link" href="/eventi/">← Tutti gli eventi</a>
    <article>
      <header class="detail__header">
        <p class="eyebrow">Evento</p>
        <h1>{event.title}</h1>
        <div class="detail__meta">
          <time datetime={event.date}>{formatDateTime(event.date)}</time>
          {event.place && <span>{event.place}</span>}
          <span>{eventStatusLabel(event.status)}</span>
        </div>
      </header>

      {event.imageUrl && <div class="detail__image detail__image--poster"><ContentImage src={event.imageUrl} alt={`Locandina: ${event.title}`} variant="poster" eager /></div>}
      {event.descriptionHtml && <div class="detail__body" set:html={event.descriptionHtml} />}

      {
        event.galleryImageUrls.length > 0 && (
          <section class="section" aria-labelledby="galleria-evento">
            <h2 id="galleria-evento">Galleria</h2>
            <ul class="gallery-grid">
              {event.galleryImageUrls.map((url, index) => (
                <li><ContentImage src={url} alt={`${event.title}, foto ${index + 1}`} variant="gallery" /></li>
              ))}
            </ul>
          </section>
        )
      }

      {
        event.relatedProjects.length > 0 && (
          <section class="section detail__related" aria-labelledby="progetti-evento">
            <h2 id="progetti-evento">Progetti collegati</h2>
            <div class="content-grid">
              {event.relatedProjects.map((project) => (
                <ContentCard kind="project" href={`/progetti/${project.slug}/`} title={project.name} imageUrl={project.imageUrl} />
              ))}
            </div>
          </section>
        )
      }
    </article>
  </main>
</BaseLayout>
