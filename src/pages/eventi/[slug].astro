---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContentImage from '@/components/ContentImage.astro';
import DetailGallery from '@/components/DetailGallery.astro';
import RichTextContent from '@/components/RichTextContent.astro';
import InitiativeList from '@/components/InitiativeList.astro';
import RelatedContentSection from '@/components/RelatedContentSection.astro';
import FacebookDiscussion from '@/components/FacebookDiscussion.astro';
import { contentRepository } from '@/content';
import { requireBySlug, staticPathsFromSlugs } from '@/utils/content';
import { formatDateTime } from '@/utils/date';
import { eventStatusLabel } from '@/utils/labels';
import { SITE_NAME } from '@/config/site';
import { sitePath } from '@/utils/sitePath';
import { eventDisplayStatus, isEventArchived } from '@/utils/events';

export const getStaticPaths = (async () => {
  const events = await contentRepository.listEvents();

  return staticPathsFromSlugs(events);
}) satisfies GetStaticPaths;

const slug = Astro.params.slug;
const event = await requireBySlug(slug, contentRepository.getEventBySlug, 'Evento');
const archived = isEventArchived(event);
---

<BaseLayout title={`${event.title} | ${SITE_NAME}`}>
  <main id="contenuto" class="container detail">
    <a class="text-link" href={sitePath(archived ? '/eventi/archivio/' : '/eventi/')}>← {archived ? 'Archivio eventi' : 'Eventi in programma'}</a>
    <article>
      <header class="detail__header">
        <p class="eyebrow">Evento</p>
        <h1>{event.title}</h1>
        <div class="detail__meta">
          <time datetime={event.date}>{formatDateTime(event.date)}</time>
          {event.place && <span>{event.place}</span>}
          <span>{eventStatusLabel(eventDisplayStatus(event))}</span>
        </div>
      </header>

      {event.imageUrl && <div class="detail__image detail__image--poster"><ContentImage src={event.imageUrl} alt={`Locandina: ${event.title}`} variant="poster" eager /></div>}
      <RichTextContent html={event.descriptionHtml} />
      <DetailGallery id="galleria-evento" title="Le foto" imageAlt={event.title} imageUrls={event.galleryImageUrls} />

      {event.discussionUrl && <FacebookDiscussion url={event.discussionUrl} />}

      {
        event.relatedInitiatives.length > 0 && (
          <RelatedContentSection id="iniziative-evento" title="Oltre questo evento" description="Esplora le iniziative a cui è legato questo incontro.">
            <InitiativeList initiatives={event.relatedInitiatives} />
          </RelatedContentSection>
        )
      }
    </article>
  </main>
</BaseLayout>
