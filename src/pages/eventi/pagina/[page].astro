---
import type { GetStaticPaths, Page } from 'astro';
import ArchiveLayout from '@/layouts/ArchiveLayout.astro';
import EventGrid from '@/components/EventGrid.astro';
import EventNavigation from '@/components/EventNavigation.astro';
import { contentRepository } from '@/content';
import type { EventSummary } from '@/content/types';
import { ARCHIVE_PAGE_SIZE } from '@/config/pagination';
import { groupEventsByDate } from '@/utils/events';

export const getStaticPaths = (async ({ paginate }) => {
  const { future } = groupEventsByDate(await contentRepository.listEvents());
  return paginate(future, {
    pageSize: ARCHIVE_PAGE_SIZE,
  }).slice(1);
}) satisfies GetStaticPaths;

interface Props {
  page: Page<EventSummary>;
}

const { page } = Astro.props;
---

<ArchiveLayout title="Eventi" description="Gli appuntamenti di oggi e dei prossimi giorni." emptyMessage="Non ci sono appuntamenti in programma." basePath="/eventi/" currentPage={page.currentPage} totalItems={page.total}>
  <EventNavigation slot="navigation" />
  <section class="event-archive__group" aria-labelledby="eventi-in-programma">
    <h2 id="eventi-in-programma">In programma</h2>
    <EventGrid events={page.data} />
  </section>
</ArchiveLayout>
