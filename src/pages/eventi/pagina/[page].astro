---
import type { GetStaticPaths, Page } from 'astro';
import ArchiveLayout from '@/layouts/ArchiveLayout.astro';
import EventGrid from '@/components/EventGrid.astro';
import { contentRepository } from '@/content';
import type { EventSummary } from '@/content/types';
import { ARCHIVE_PAGE_SIZE } from '@/config/pagination';
import { BRAND_WORDMARK } from '@/config/site';

export const getStaticPaths = (async ({ paginate }) => {
  const events = await contentRepository.listEvents();
  return paginate(events, { pageSize: ARCHIVE_PAGE_SIZE }).slice(1);
}) satisfies GetStaticPaths;

interface Props {
  page: Page<EventSummary>;
}

const { page } = Astro.props;
---

<ArchiveLayout title="Eventi e iniziative" eyebrow={BRAND_WORDMARK} emptyMessage="Non ci sono ancora eventi pubblicati." basePath="/eventi/" currentPage={page.currentPage} totalItems={page.total}>
  <EventGrid events={page.data} />
</ArchiveLayout>
