---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EventCard from '@/components/EventCard.astro';
import { contentRepository } from '@/content';
import { formatDateTime } from '@/utils/date';
import { eventStatusLabel } from '@/utils/labels';
import { BRAND_WORDMARK, SITE_NAME } from '@/config/site';

const events = await contentRepository.listEvents();
---

<BaseLayout title={`Eventi | ${SITE_NAME}`}>
  <main id="contenuto" class="container">
    <div class="page-intro">
      <p class="eyebrow">{BRAND_WORDMARK}</p>
      <h1>Eventi e iniziative</h1>
    </div>
    {events.length === 0 ? (
      <p class="notice">Non ci sono ancora eventi pubblicati.</p>
    ) : (
      <div class="content-grid">
        {events.map((event) => (
          <EventCard headingLevel={2} href={`/eventi/${event.slug}/`} title={event.title} imageUrl={event.imageUrl} meta={`${formatDateTime(event.date)} · ${eventStatusLabel(event.status)}${event.place ? ` · ${event.place}` : ''}`} />
        ))}
      </div>
    )}
  </main>
</BaseLayout>
