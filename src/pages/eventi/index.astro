---
import ArchiveLayout from '@/layouts/ArchiveLayout.astro';
import EventGrid from '@/components/EventGrid.astro';
import { contentRepository } from '@/content';
import { ARCHIVE_PAGE_SIZE } from '@/config/pagination';
import { BRAND_WORDMARK } from '@/config/site';

const events = await contentRepository.listEvents();
---

<ArchiveLayout title="Eventi e iniziative" eyebrow={BRAND_WORDMARK} emptyMessage="Non ci sono ancora eventi pubblicati." basePath="/eventi/" currentPage={1} totalItems={events.length}>
  <EventGrid events={events.slice(0, ARCHIVE_PAGE_SIZE)} />
</ArchiveLayout>
