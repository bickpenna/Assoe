---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { contentRepository } from '@/content';
import { formatDateTime } from '@/utils/date';
import { eventStatusLabel } from '@/utils/labels';

const events = await contentRepository.listEvents();
---

<BaseLayout title="Eventi | Asso è… La Strada ci Insegna ODV">
  <main>
    <h1>Eventi</h1>

    {
      events.length === 0 ? (
        <p>Non ci sono ancora eventi pubblicati.</p>
      ) : (
        <ul>
          {events.map((event) => (
            <li>
              <article>
                <h2><a href={`/eventi/${event.slug}/`}>{event.title}</a></h2>
                <p><time datetime={event.date}>{formatDateTime(event.date)}</time></p>
                {event.place && <p>Luogo: {event.place}</p>}
                <p>Stato: {eventStatusLabel(event.status)}</p>
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</BaseLayout>
