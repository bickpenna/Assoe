---
import ArchiveLayout from '@/layouts/ArchiveLayout.astro';
import ProjectList from '@/components/ProjectList.astro';
import { contentRepository } from '@/content';
import { ARCHIVE_PAGE_SIZE } from '@/config/pagination';
import { BRAND_WORDMARK } from '@/config/site';

const projects = await contentRepository.listProjects();
---

<ArchiveLayout title="I nostri progetti" eyebrow={BRAND_WORDMARK} emptyMessage="Non ci sono ancora progetti pubblicati." basePath="/progetti/" currentPage={1} totalItems={projects.length}>
  <ProjectList projects={projects.slice(0, ARCHIVE_PAGE_SIZE)} headingLevel={2} />
</ArchiveLayout>
