---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectList from '@/components/ProjectList.astro';
import { contentRepository } from '@/content';
import { BRAND_WORDMARK, SITE_NAME } from '@/config/site';

const projects = await contentRepository.listProjects();
---

<BaseLayout title={`Progetti | ${SITE_NAME}`}>
  <main id="contenuto" class="container">
    <div class="page-intro">
      <p class="eyebrow">{BRAND_WORDMARK}</p>
      <h1>I nostri progetti</h1>
    </div>
    {projects.length === 0 ? (
      <p class="notice">Non ci sono ancora progetti pubblicati.</p>
    ) : (
      <ProjectList projects={projects} headingLevel={2} />
    )}
  </main>
</BaseLayout>
