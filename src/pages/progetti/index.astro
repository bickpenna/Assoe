---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { contentRepository } from '@/content';

const projects = await contentRepository.listProjects();
---

<BaseLayout title="Progetti | Asso è… La Strada ci Insegna ODV">
  <main>
    <h1>Progetti</h1>

    {
      projects.length === 0 ? (
        <p>Non ci sono ancora progetti pubblicati.</p>
      ) : (
        <ul>
          {projects.map((project) => (
            <li><a href={`/progetti/${project.slug}/`}>{project.name}</a></li>
          ))}
        </ul>
      )
    }
  </main>
</BaseLayout>
