---
import type { GetStaticPaths, Page } from 'astro';
import ArchiveLayout from '@/layouts/ArchiveLayout.astro';
import ProjectList from '@/components/ProjectList.astro';
import { contentRepository } from '@/content';
import type { ProjectSummary } from '@/content/types';
import { ARCHIVE_PAGE_SIZE } from '@/config/pagination';
import { BRAND_WORDMARK } from '@/config/site';

export const getStaticPaths = (async ({ paginate }) => {
  const projects = await contentRepository.listProjects();
  return paginate(projects, { pageSize: ARCHIVE_PAGE_SIZE }).slice(1);
}) satisfies GetStaticPaths;

interface Props {
  page: Page<ProjectSummary>;
}

const { page } = Astro.props;
---

<ArchiveLayout title="I nostri progetti" eyebrow={BRAND_WORDMARK} emptyMessage="Non ci sono ancora progetti pubblicati." basePath="/progetti/" currentPage={page.currentPage} totalItems={page.total}>
  <ProjectList projects={page.data} headingLevel={2} />
</ArchiveLayout>
