---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContentCard from '@/components/ContentCard.astro';
import ContentImage from '@/components/ContentImage.astro';
import { contentRepository } from '@/content';
import { formatDateTime, formatDate } from '@/utils/date';

export const getStaticPaths = (async () => {
  const projects = await contentRepository.listProjects();

  return projects.map(({ slug }) => ({ params: { slug } }));
}) satisfies GetStaticPaths;

const slug = Astro.params.slug;
const project = slug ? await contentRepository.getProjectBySlug(slug) : null;

if (!project) {
  throw new Error(`Progetto non trovato durante la build: ${slug ?? '(slug mancante)'}`);
}
---

<BaseLayout title={`${project.name} | Asso è… La Strada ci Insegna ODV`}>
  <main id="contenuto" class="container detail">
    <div class="detail__header">
      <a class="text-link" href="/progetti/">← Tutti i progetti</a>
      <p class="eyebrow">Asso è…</p>
      <h1>{project.name}</h1>
    </div>
    {project.imageUrl && <div class="detail__image"><ContentImage src={project.imageUrl} alt={`Immagine del progetto ${project.name}`} variant="hero" eager /></div>}
    {project.descriptionHtml && <div class="detail__body" set:html={project.descriptionHtml} />}

    {
      project.relatedArticles.length > 0 && (
        <section class="section detail__related" aria-labelledby="articoli-progetto">
          <h2 id="articoli-progetto">Articoli collegati</h2>
          <div class="content-grid">
            {project.relatedArticles.map((article) => (
              <ContentCard kind="article" href={`/articoli/${article.slug}/`} title={article.title} imageUrl={article.imageUrl} meta={formatDate(article.publishedAt)} summary={article.summary} />
            ))}
          </div>
        </section>
      )
    }

    {
      project.relatedEvents.length > 0 && (
        <section class="section detail__related" aria-labelledby="eventi-progetto">
          <h2 id="eventi-progetto">Eventi collegati</h2>
          <div class="content-grid">
            {project.relatedEvents.map((event) => (
              <ContentCard kind="event" href={`/eventi/${event.slug}/`} title={event.title} imageUrl={event.imageUrl} meta={formatDateTime(event.date)} />
            ))}
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>
