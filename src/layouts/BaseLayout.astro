---
import { getImage } from 'astro:assets';
import '@/styles/global.css';
import SiteBrand from '@/components/SiteBrand.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { contentRepository } from '@/content';
import type { AssociationInfo } from '@/content/types';
import { siteNavigation } from '@/config/navigation';
import { SITE_NAME } from '@/config/site';
import { sitePath } from '@/utils/sitePath';

interface Props {
  title: string;
  description?: string;
  association?: AssociationInfo | null;
}

const {
  title,
  description = SITE_NAME,
  association: providedAssociation,
} = Astro.props;

const association = providedAssociation === undefined
  ? await contentRepository.getAssociationInfo()
  : providedAssociation;
let favicon = null;
if (association?.logoUrl) {
  try {
    favicon = await getImage({ src: association.logoUrl, width: 64, height: 64, fit: 'contain', format: 'png' });
  } catch {
    // Il logo remoto non deve impedire il rendering della pagina.
  }
}

const currentPath = Astro.url.pathname;
const homePath = sitePath('/');
const isCurrent = (href: string) => href === homePath ? currentPath === homePath : currentPath.startsWith(href);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <slot name="head" />
    {favicon && <link rel="icon" type="image/png" href={favicon.src} />}
    {import.meta.env.PUBLIC_SITE_PREVIEW === 'true' && <meta name="robots" content="noindex,nofollow" />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <SiteBrand logoUrl={association?.logoUrl} name={association?.name} />
        <nav class="desktop-nav" aria-label="Navigazione principale">
          {siteNavigation.map((item) => <a href={item.href} class:list={{ 'nav-cta': item.featured }} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <details class="mobile-nav">
          <summary>
            <span class="visually-hidden">Menu di navigazione</span>
            <span class="mobile-nav__icon" aria-hidden="true"><span></span><span></span><span></span></span>
          </summary>
          <nav aria-label="Navigazione mobile">
            {siteNavigation.map((item) => <a href={item.href} class:list={{ 'nav-cta': item.featured }} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
          </nav>
        </details>
      </div>
    </header>
    <slot />
    <SiteFooter association={association} />
  </body>
</html>
