---
import '@/styles/global.css';
import SiteBrand from '@/components/SiteBrand.astro';
import { contentRepository } from '@/content';
import type { AssociationInfo } from '@/content/types';
import { footerNavigation, siteNavigation } from '@/config/navigation';
import { SITE_NAME } from '@/config/site';

interface Props {
  title: string;
  description?: string;
  association?: AssociationInfo | null;
}

const {
  title,
  description = SITE_NAME,
  association: providedAssociation,
} = Astro.props;

const association = providedAssociation === undefined
  ? await contentRepository.getAssociationInfo()
  : providedAssociation;

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <SiteBrand logoUrl={association?.logoUrl} name={association?.name} placement="header" />
        <nav class="desktop-nav" aria-label="Navigazione principale">
          {siteNavigation.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <details class="mobile-nav">
          <summary>Menu</summary>
          <nav aria-label="Navigazione mobile">
            {siteNavigation.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
          </nav>
        </details>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="container">
        <div class="site-footer__grid">
          <div>
            <SiteBrand logoUrl={association?.logoUrl} name={association?.name} placement="footer" />
            {association?.name && <p>{association.name}</p>}
          </div>
          <div>
            <h2>Esplora</h2>
            {footerNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>
          <div>
            <h2>Informazioni</h2>
            <a href="/contatti/">Contatti</a>
            {association?.documents.statuteUrl && <a href={association.documents.statuteUrl}>Statuto (PDF)</a>}
            {association?.documents.privacyPolicyUrl && <a href={association.documents.privacyPolicyUrl}>Privacy (PDF)</a>}
            {association?.documents.cookiePolicyUrl && <a href={association.documents.cookiePolicyUrl}>Cookie (PDF)</a>}
          </div>
        </div>
        <div class="site-footer__bottom">{association?.copyright ?? SITE_NAME}</div>
      </div>
    </footer>
  </body>
</html>
