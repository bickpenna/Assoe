---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Associazione Asso è… La Strada ci Insegna ODV',
} = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
