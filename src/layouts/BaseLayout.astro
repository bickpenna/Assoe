---
import { contentRepository } from '@/content';
import type { AssociationInfo } from '@/content/types';

interface Props {
  title: string;
  description?: string;
  association?: AssociationInfo | null;
}

const {
  title,
  description = 'Associazione Asso è… La Strada ci Insegna ODV',
  association: providedAssociation,
} = Astro.props;

const association = providedAssociation === undefined
  ? await contentRepository.getAssociationInfo()
  : providedAssociation;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a href="/" aria-label="Vai alla pagina iniziale">{association?.name ?? 'Asso è… La Strada ci Insegna ODV'}</a>
      <nav aria-label="Navigazione principale">
        <a href="/">Home</a>
        <a href="/progetti/">Progetti</a>
        <a href="/articoli/">Articoli</a>
        <a href="/eventi/">Eventi</a>
        <a href="/chi-siamo/">Chi siamo</a>
        <a href="/contatti/">Contatti</a>
      </nav>
    </header>
    <slot />
    <footer>
      <p>{association?.copyright ?? association?.name ?? 'Asso è… La Strada ci Insegna ODV'}</p>
      <p><a href="/contatti/">Contatti</a></p>
    </footer>
  </body>
</html>
