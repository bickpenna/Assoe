---
import '@/styles/global.css';
import SiteBrand from '@/components/SiteBrand.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { contentRepository } from '@/content';
import type { AssociationInfo } from '@/content/types';
import { siteNavigation } from '@/config/navigation';
import { SITE_NAME } from '@/config/site';

interface Props {
  title: string;
  description?: string;
  association?: AssociationInfo | null;
}

const {
  title,
  description = SITE_NAME,
  association: providedAssociation,
} = Astro.props;

const association = providedAssociation === undefined
  ? await contentRepository.getAssociationInfo()
  : providedAssociation;

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <SiteBrand logoUrl={association?.logoUrl} name={association?.name} placement="header" />
        <nav class="desktop-nav" aria-label="Navigazione principale">
          {siteNavigation.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <details class="mobile-nav">
          <summary>Menu</summary>
          <nav aria-label="Navigazione mobile">
            {siteNavigation.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
          </nav>
        </details>
      </div>
    </header>
    <slot />
    <SiteFooter association={association} />
  </body>
</html>
