@startuml

' ============================================================
' Contenuti globali
' ============================================================

class InformazioniAssociazione <<singleton>> {
    -nomeAssociazione: String
    -testoBreveHome: Text (opzionale, massimo 200 caratteri)
    -logo: Image (opzionale)
    -testoChiSiamo: Text (opzionale)
    -fotoChiSiamo: Image (opzionale)
    -codiceFiscale: String (opzionale)
    -datiBancari: DatiBancari (opzionale)
    -datiRegistro: String (opzionale)
    -copyright: String (opzionale)
    -statuto: File (opzionale)
    -regolamento: File (opzionale)
    -privacyPolicy: File (opzionale)
    -cookiePolicy: File (opzionale)
}

class Contatti {
    -email: Email (opzionale)
    -telefono: String (opzionale)
    -indirizzo: String (opzionale)
    -cap: String (opzionale)
    -citta: String (opzionale)
    -provincia: String (opzionale)
}

class ProfiloSocial {
    -nomeSocial: String
    -linkSocial: URL
}

class DatiBancari {
    -iban: String
    -intestatario: String
    -banca: String (opzionale)
}

class Avvisi <<singleton>> {
    -avvisi: List<Avviso> (massimo 3, ordinabile)
}

class Avviso {
    -titolo: String
    -testo: Markdown (massimo 500 caratteri)
    -documento: File PDF (opzionale)
    -link: URL HTTPS (opzionale)
    -testoLink: String (opzionale, massimo 80 caratteri)
    -visibileFinoAl: Date (opzionale)
}

' ============================================================
' Contenuti editoriali
' ============================================================

class Iniziativa {
    -nome: String
    -ambito: AmbitoIniziativa (obbligatorio nello Studio)
    -slug: Slug
    -descrizione: RichText (opzionale)
    -immagine: Image (opzionale)
    -orderRank: String (gestito da Studio, opzionale per dati legacy)
    -ordine: Integer (legacy, opzionale)
    -attiva: Boolean (default true)
}

class Articolo {
    -titolo: String
    -slug: Slug
    -sommario: String (opzionale)
    -testo: RichText (opzionale)
    -postFacebook: URL (opzionale)
    -immaginePrincipale: Image (opzionale)
    -galleria: List<Image> (opzionale, massimo 6)
    -dataPubblicazione: DateTime
}

class Evento {
    -titolo: String
    -slug: Slug
    -descrizione: RichText (opzionale)
    -postFacebook: URL (opzionale)
    -data: DateTime
    -luogo: String (opzionale)
    -locandina: Image (opzionale)
    -galleria: List<Image> (opzionale, massimo 6)
    -stato: StatoEvento
}

class Persona {
    -nome: String
    -cognome: String
    -foto: Image (opzionale)
    -ruolo: RuoloPersona
    -orderRank: String (gestito da Studio)
    -ordine: Integer (legacy, opzionale)
    -visibile: Boolean (default true)
}

' ==============================================================
' Enumerazioni
' ==============================================================

enum AmbitoIniziativa {
    Sociali
    Volontariato
}

enum RuoloPersona {
    Presidente
    Vicepresidente
    Segretario
    Consigliere
    Volontario
    VolontarioServizioCivile
}

enum StatoEvento {
    Programmato
    InCorso
    Concluso
    Annullato
}

' ============================================================
' Relazioni
' ============================================================

InformazioniAssociazione "1" *-- "1" Contatti
InformazioniAssociazione "1" *-- "0..*" ProfiloSocial
InformazioniAssociazione "1" *-- "0..1" DatiBancari
Avvisi "1" *-- "0..3" Avviso

Articolo "0..*" --> "0..*" Iniziativa : riguarda
Evento "0..*" --> "0..*" Iniziativa : riguarda
Articolo "0..*" --> "0..1" Evento : racconta

note right of InformazioniAssociazione
    Documento singleton in Sanity:
    tipo e ID "siteSettings".
    Contiene i dati usati
    nell'header, nel footer e
    nelle pagine Home, Chi siamo e Sostienici.
    Le coordinate bancarie sono
    mostrate solo se complete.
end note

note right of Avvisi
    Documento singleton "homeSettings" in Sanity.
    Nello Studio appare come "Avvisi".
    L'ordine della lista è quello mostrato
    nella homepage; senza avvisi visibili la sezione non appare.
    La data di scadenza è inclusa (fuso Europe/Rome).
end note

note right of ProfiloSocial
    Nel CMS i campi si chiamano
    "Nome social" e "Link social".
    Le chiavi salvate sono
    "platform" e "url".
end note

note right of Iniziativa
    I volontari possono creare
    nuove iniziative dal CMS.
    Il tipo salvato è "initiative"
    e i riferimenti sono "initiatives"
    per mantenere coerenti modello e linguaggio del sito.
    Il campo "area" vale "social" o "volunteering".
    Cambiarlo mantiene ID, slug e riferimenti.
    L'ambito è obbligatorio per pubblicare.
    I nuovi documenti nascono con una delle due scelte.
end note

note right of Articolo
    Il layout è deciso da Astro.
    I volontari compilano solo
    contenuti e metadati.
    Lo slug pubblico include la data
    di pubblicazione nel fuso Europe/Rome
    e la parte breve inserita nello Studio.
end note

@enduml
