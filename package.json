{
  "name": "assoe-volontariato",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:build": "node scripts/check-static-output.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include='src/utils/*.ts' --test-coverage-include='shared/*.ts' --test-coverage-include='src/content/providers/sanityImage.ts' --test-coverage-include='src/content/providers/sanityValidation.ts' --test-coverage-include='src/content/providers/sanityMappers.ts' --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=100 --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/epilogue": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@portabletext/to-html": "^6.0.0",
    "@sanity/client": "^8.9.0",
    "astro": "^7.4.0",
    "marked": "^18.1.2",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/sanitize-html": "^2.16.2",
    "typescript": "^6.0.3"
  }
}
